# SQLite database URL (local development).
# The db/ folder is created automatically. For local dev, run `bun run db:push`
# after changing the Prisma schema to (re)create the tables.
DATABASE_URL="file:./db/reel.db"

# ---------------------------------------------------------------------------
# Vercel / serverless notes
# ---------------------------------------------------------------------------
# On Vercel the filesystem is read-only except /tmp, so this app automatically
# uses an ephemeral SQLite database at `file:/tmp/reel.db` when DATABASE_URL is
# not set. History will work within a single warm instance but will not persist
# across cold starts or be shared between instances.
#
# For PERSISTENT history on Vercel, set DATABASE_URL to a hosted database, e.g.
# a Turso (libSQL) connection string:
#   DATABASE_URL="libsql://<your-db>.turso.io?authToken=<token>"
# (and add the matching Prisma datasource adapter — see Prisma + Turso docs).
